# Copy this file to `.env` and fill in your values.
# Postgres is required (SQLite works only in local dev before this migration to Vercel).

# Free hosted Postgres: https://neon.tech (helps.marketplace "Neon" inside Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.region.aws.neon.tech/farmdirect?sslmode=require"

# Long random string used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-64-hex-string"

# eSewa test/sandbox credentials
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"
ESEWA_TEST_MODE="true"

# Vercel Blob token for product image uploads (create a Blob store in Vercel -> Storage).
# Leave empty for local development.
BLOB_READ_WRITE_TOKEN=""